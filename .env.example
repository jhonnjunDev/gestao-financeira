# ============================================================
# CONFIGURAÇÃO DO BANCO DE DADOS
# ============================================================
# DESENVOLVIMENTO LOCAL (padrão — SQLite, zero configuração):
DATABASE_URL="file:./dev.db"

# PRODUÇÃO — PostgreSQL (Ubuntu + Nginx). Descomente e preencha:
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/gestao_financeira?schema=public"

# ============================================================
# AUTENTICAÇÃO
# ============================================================
# Segredo usado para assinar os tokens JWT. Gere um com: openssl rand -hex 32
JWT_SECRET="troque-este-segredo-por-um-valor-longo-e-aleatorio-0123456789abcdef"

# URL base do sistema (produção):
NEXTAUTH_URL="http://localhost:3000"

# ============================================================
# DEMONSTRAÇÃO
# ============================================================
# Se "true", o seed cria dados fictícios para demonstrar o sistema.
SEED_DEMO="true"
